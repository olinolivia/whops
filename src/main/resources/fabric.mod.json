{
	"schemaVersion": 1,
	"id": "whops",
	"version": "${version}",
	"name": "whops",
	"description": "An all-in-one dependency for your parkour maps!",
	"authors": [
		"olinolívia"
	],
	"contact": {
		"sources": "https://github.com/olinolivia/whops"
	},
	"license": "CC0-1.0",
	"icon": "assets/whops/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"olinolivia.whops.Whops"
		],
		"client": [
			"olinolivia.whops.client.WhopsClient"
		]
	},
	"mixins": [
		"whops.mixins.json",
		{
			"config": "whops.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "whops.classtweaker",
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
